    "learning_moments": {
        "shadow_foundation": {
            "title": "📚 LERNMOMENT: AWS IoT Device Shadow-Service Grundlagen",
            "content": "AWS IoT Device Shadow ist ein JSON-Dokument, das aktuelle Zustandsinformationen für ein Gerät speichert und abruft. Der Shadow fungiert als Vermittler zwischen Geräten und Anwendungen und ermöglicht zuverlässige Kommunikation auch wenn Geräte offline sind. Das Verständnis von Shadow-Konzepten ist essentiell für robuste IoT-Anwendungen.",
            "next": "Wir werden Shadow-Operationen und MQTT-Kommunikation erkunden"
        },
        "shadow_connection": {
            "title": "📚 LERNMOMENT: Shadow MQTT-Verbindung",
            "content": "Device Shadows nutzen MQTT-Topics für die Kommunikation. Jede Shadow-Operation (get, update, delete) hat entsprechende accepted/rejected Response-Topics. Delta-Topics benachrichtigen, wenn sich Desired State vom Reported State unterscheidet. Dieses Pub/Sub-Modell ermöglicht Echtzeit-Bidirektionale Kommunikation zwischen Geräten und Anwendungen.",
            "next": "Wir werden MQTT-Verbindung herstellen und Shadow-Topics abonnieren"
        },
        "shadow_document": {
            "title": "📚 LERNMOMENT: Shadow-Dokumentstruktur",
            "content": "Ein Shadow-Dokument enthält 'desired' und 'reported' States. Desired State repräsentiert was das Gerät sein sollte, typischerweise von Anwendungen gesetzt. Reported State repräsentiert den aktuellen Zustand des Geräts. Wenn diese sich unterscheiden, generiert AWS IoT Delta-Nachrichten um das Gerät über erforderliche Änderungen zu informieren.",
            "next": "Wir werden das aktuelle Shadow-Dokument abrufen und analysieren"
        },
        "reported_state": {
            "title": "📚 LERNMOMENT: Reported State-Updates",
            "content": "Geräte aktualisieren ihren Reported State um die Cloud über ihren aktuellen Status zu informieren. Dies geschieht typischerweise nachdem das Gerät seinen physischen Zustand geändert hat (Temperatur, Status, etc.). Reported State-Updates helfen den Shadow mit dem tatsächlichen Gerätezustand synchron zu halten.",
            "next": "Wir werden den Reported State des Shadows vom Gerät aktualisieren"
        },
        "desired_state": {
            "title": "📚 LERNMOMENT: Desired State-Updates",
            "content": "Anwendungen setzen den Desired State um Geräteänderungen anzufordern. Wenn sich Desired State vom Reported State unterscheidet, sendet AWS IoT Delta-Nachrichten an das Gerät. Dieser Mechanismus ermöglicht Fernsteuerung und Konfigurationsverwaltung von Geräten über die Cloud.",
            "next": "Wir werden den Desired State des Shadows von der Cloud aktualisieren"
        },
        "state_simulation": {
            "title": "📚 LERNMOMENT: Gerätezustands-Simulation",
            "content": "Das Simulieren von Gerätezustandsänderungen hilft den kompletten Shadow-Workflow zu verstehen. Wir werden lokalen Gerätezustand ändern und sehen wie er sich durch den Shadow-Service propagiert. Dies demonstriert die bidirektionale Natur der Shadow-Kommunikation und Zustandssynchronisation.",
            "next": "Wir werden realistische Gerätezustandsänderungen simulieren"
        }
    },
